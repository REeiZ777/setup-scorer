{
  "name": "setup-scorer",
  "productName": "Setup Scorer",
  "version": "0.1.1",
  "description": "Score statistique d’un setup de trading, en popup toujours au premier plan",
  "main": "main.js",
  "author": "Chris",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "logo": "node tools/make-logo.js",
    "logo:file": "electron tools/logo-from-file.js",
    "build:win": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.setupscorer",
    "productName": "Setup Scorer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Setup-Scorer-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "REeiZ777",
        "repo": "setup-scorer",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/REeiZ777/setup-scorer.git"
  },
  "homepage": "https://github.com/REeiZ777/setup-scorer"
}
